# Flask Application Configuration
SECRET_KEY=generate_a_secure_random_key_here
FLASK_ENV=development
FLASK_APP=app.py

# Database Configuration (MySQL)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vms
# Or alternatively specify full URI:
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/vms

# Security & Session
SESSION_TIMEOUT_MINUTES=60

# Device & Gate Timing
DEVICE_HEARTBEAT_TIMEOUT=35
SCAN_COOLDOWN_SECONDS=3
BARRIER_CLOSE_DELAY_SECONDS=4
DASHBOARD_REFRESH_INTERVAL=5

# Network settings for ESP32
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
