# Flask Application Configuration
SECRET_KEY=generate_a_secure_random_key_here
FLASK_ENV=development
FLASK_APP=app.py

# Database Configuration
DATABASE_URL=mysql+pymysql://<Password>@localhost/<db_name>

# Security & Session
SESSION_TIMEOUT_MINUTES=60

# Device & Gate Timing
DEVICE_HEARTBEAT_TIMEOUT=35
SCAN_COOLDOWN_SECONDS=3
BARRIER_CLOSE_DELAY_SECONDS=4
DASHBOARD_REFRESH_INTERVAL=5

# Network settings for ESP32
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
